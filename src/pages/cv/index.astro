---
import PageShell from "../../layouts/PageShell.astro";

const coreStack = ["TypeScript", "React", "React Native", "Node.js", "Bun"];
const additionalStack = ["Python", "Next.js", "Expo", "Tailwind", "PostgreSQL", "Docker", "CI/CD", "Tests"];

const earlierExperience = [
  { role: "Web Developer", company: "Re Bena Gesta", detail: "Next.js, headless WordPress, SEO", date: "Mar—May 2021" },
  { role: "Webmaster", company: "Setia.pl", detail: "Linux hosting, WordPress, SEO", date: "Jan—Mar 2021" },
  { role: "Quality Assurance", company: "RES Global Group", date: "Aug—Sep 2020" },
  { role: "Web Dev Intern", company: "Da Vinci Studio", date: "Sep—Dec 2019" },
  { role: "Sales & Customer Service", company: "Big Star Limited", date: "Jun 2018—Jan 2019" },
];

const projects = [
  {
    name: "OPTI-ENER",
    label: "mobile app",
    href: "https://apps.apple.com/pl/app/opti-ener/id6473692228",
    linkLabel: "app store ↗",
    description: "Remote access to the OPTI-ENER electricity management system for heat pumps.",
    stack: "React Native · Expo · TypeScript",
  },
  {
    name: "TypedFormData",
    label: "open source",
    href: "https://github.com/k1eu/typed-formdata",
    linkLabel: "github ↗",
    description: "A small utility library for working with FormData in TypeScript.",
    stack: "TypeScript",
  },
  {
    name: "Just TypeScript Snippets",
    label: "developer tool",
    href: "https://marketplace.visualstudio.com/items?itemName=k1eu.just-ts-snippets",
    linkLabel: "marketplace ↗",
    description: "Bare-necessities JavaScript and TypeScript snippets for VS Code.",
    stack: "VS Code · JavaScript · TypeScript",
  },
];
---

<PageShell
  title="Tomasz Kielar / CV"
  description="Tomasz Kielar — Tech Lead, full-stack engineer, and consultant."
  ogUrl="https://k1eu.dev/cv/"
  mainClass="gap-10"
>
  <article class="cv-page flex w-full flex-col gap-14 text-left">
    <header class="cv-header relative overflow-hidden border-y border-[var(--pink-soft)] py-8 sm:py-10">
      <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-40 sm:block" aria-hidden="true">
        <img
          src="/avatar.png"
          alt=""
          class="h-full w-full object-contain object-right opacity-20 drop-shadow-[0_0_24px_rgba(0,245,255,0.55)]"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black via-black/40 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-xl space-y-5">
        <div class="space-y-2">
          <p class="cv-kicker">personnel record // 001</p>
          <h1 class="glitch text-4xl font-semibold sm:text-5xl" data-text="tomasz kielar">tomasz kielar</h1>
          <p class="text-sm text-[var(--pink-bright)] sm:text-base">tech lead · full-stack engineer · consultant · cursor ambassador</p>
          <p class="text-xs uppercase tracking-[0.25em] text-[var(--pink-dim)]">bielsko-biała, poland</p>
        </div>

        <div class="flex flex-wrap gap-x-5 gap-y-2 text-xs">
          <a class="neon-link underline underline-offset-4" href="mailto:me@k1eu.dev">me@k1eu.dev</a>
          <a class="neon-link underline underline-offset-4" href="tel:+48792200218">+48 792 200 218</a>
          <a class="neon-link underline underline-offset-4" href="https://www.linkedin.com/in/k1eu/">linkedin ↗</a>
          <a class="neon-link underline underline-offset-4" href="https://github.com/k1eu">github ↗</a>
        </div>

        <button class="print-control cv-button" type="button" onclick="window.print()">print / save pdf</button>
      </div>
    </header>

    <section class="cv-section" aria-labelledby="profile-heading">
      <div class="cv-section-heading">
        <span>01</span>
        <h2 id="profile-heading">profile</h2>
      </div>

      <div class="grid gap-8 sm:grid-cols-[1.25fr_0.75fr]">
        <div class="space-y-4">
          <p class="text-sm leading-7 text-[var(--pink-bright)]">
            Tech Lead and full-stack engineer with 5+ years of experience delivering web and mobile products using
            TypeScript, React, React Native, Node.js, and Bun.
          </p>
          <p class="text-sm leading-7">
            Experienced in end-to-end delivery, technical leadership, mentoring, and client communication. Co-owner
            of bielsko.ai, focused on practical AI adoption and local community building.
          </p>
        </div>

        <div class="cv-panel space-y-4">
          <p class="cv-kicker">operating strengths</p>
          <ul class="cv-list text-xs leading-6">
            <li>architecture to release</li>
            <li>technical leadership & mentoring</li>
            <li>client & stakeholder alignment</li>
            <li>ai-assisted development</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="cv-section" aria-labelledby="stack-heading">
      <div class="cv-section-heading">
        <span>02</span>
        <h2 id="stack-heading">stack</h2>
      </div>

      <div class="space-y-7">
        <div class="space-y-3">
          <p class="cv-kicker">core systems</p>
          <ul class="flex flex-wrap gap-2" aria-label="Core technologies">
            {coreStack.map((technology) => <li class="cv-chip cv-chip-strong">{technology}</li>)}
          </ul>
        </div>
        <div class="space-y-3">
          <p class="cv-kicker">additional modules</p>
          <ul class="flex flex-wrap gap-2" aria-label="Additional technologies">
            {additionalStack.map((technology) => <li class="cv-chip">{technology}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="cv-section" aria-labelledby="experience-heading">
      <div class="cv-section-heading">
        <span>03</span>
        <h2 id="experience-heading">experience</h2>
      </div>

      <div class="cv-timeline space-y-10">
        <article class="cv-timeline-item space-y-5">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="display text-xl font-semibold text-[var(--pink-bright)]">Selleo</h3>
              <p class="mt-1 text-sm">full-stack engineer / tech lead</p>
            </div>
            <p class="cv-date">may 2021—present · hybrid</p>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div class="cv-panel space-y-2">
              <h4 class="text-sm text-[var(--pink-bright)]">Full-stack engineer / Tech lead</h4>
              <p class="cv-date">may 2023—present</p>
              <ul class="cv-list text-xs leading-6">
                <li>Own end-to-end delivery: architecture, implementation, and client communication.</li>
                <li>Build full-stack Node.js and Bun applications.</li>
                <li>Lead projects, mentor developers, and run technical training.</li>
              </ul>
            </div>
            <div class="cv-panel space-y-2">
              <h4 class="text-sm text-[var(--pink-bright)]">Frontend developer</h4>
              <p class="cv-date">may 2021—may 2023</p>
              <ul class="cv-list text-xs leading-6">
                <li>Built React and React Native applications for EdTech and PropTech clients.</li>
                <li>Led frontend delivery and contributed across the product lifecycle.</li>
              </ul>
            </div>
          </div>
        </article>

        <article class="cv-timeline-item space-y-3">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="display text-xl font-semibold text-[var(--pink-bright)]">bielsko.ai</h3>
              <p class="mt-1 text-sm">co-owner</p>
            </div>
            <p class="cv-date">apr 2026—present</p>
          </div>
          <ul class="cv-list text-sm leading-7">
            <li>Build a local community around practical AI adoption.</li>
            <li>Develop the brand, secure financing and partnerships, and organize events.</li>
            <li>Present practical AI workflows to the local community.</li>
          </ul>
        </article>

        <article class="cv-timeline-item space-y-3">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="display text-xl font-semibold text-[var(--pink-bright)]">recave</h3>
              <p class="mt-1 text-sm">co-founder & developer</p>
            </div>
            <p class="cv-date">2 client projects</p>
          </div>
          <p class="text-sm leading-7">
            Co-founded a product and consultancy initiative delivering business applications for external clients,
            alongside technical media and podcasts.
          </p>
        </article>

        <article class="cv-timeline-item space-y-4">
          <p class="cv-kicker">earlier assignments</p>
          <div class="divide-y divide-[var(--pink-soft)] border-y border-[var(--pink-soft)]">
            {
              earlierExperience.map(({ role, company, detail, date }) => (
                <div class="grid gap-1 py-3 text-xs sm:grid-cols-[1fr_auto] sm:gap-6">
                  <p>
                    <span class="text-[var(--pink-bright)]">{company} / {role}</span>
                    {detail && <span class="text-[var(--pink-dim)]"> · {detail}</span>}
                  </p>
                  <p class="cv-date">{date}</p>
                </div>
              ))
            }
          </div>
        </article>
      </div>
    </section>

    <section class="cv-section" aria-labelledby="projects-heading">
      <div class="cv-section-heading">
        <span>04</span>
        <h2 id="projects-heading">selected projects</h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        {
          projects.map(({ name, label, href, linkLabel, description, stack }) => (
            <article class="cv-panel flex min-h-56 flex-col gap-4">
              <div class="space-y-1">
                <p class="cv-kicker">{label}</p>
                <h3 class="display text-lg font-semibold text-[var(--pink-bright)]">{name}</h3>
              </div>
              <p class="text-xs leading-6">{description}</p>
              <div class="mt-auto space-y-3">
                <p class="text-[0.65rem] uppercase tracking-[0.18em] text-[var(--pink-dim)]">{stack}</p>
                <a class="neon-link text-xs underline underline-offset-4" href={href}>{linkLabel}</a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="cv-section" aria-labelledby="recommendations-heading">
      <div class="cv-section-heading">
        <span>05</span>
        <h2 id="recommendations-heading">field reports</h2>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <blockquote class="cv-quote">
          <p>
            “Exceptional lead full-stack developer — he consistently delivered high-quality code. Tomasz's
            leadership was instrumental in the project's success.”
          </p>
          <footer>Samuel Helm · Project Manager (client) · 2025</footer>
        </blockquote>
        <blockquote class="cv-quote">
          <p>
            “Our mobile app project would not have been a success without Tomasz. His insights into the mobile
            development process were invaluable.”
          </p>
          <footer>Haley Power · Brand + Training Specialist · 2023</footer>
        </blockquote>
      </div>
      <p class="mt-5 text-xs text-[var(--pink-dim)]">
        complete reports available on
        <a class="neon-link underline underline-offset-4" href="https://www.linkedin.com/in/k1eu/">linkedin ↗</a>
      </p>
    </section>

    <section class="cv-section" aria-labelledby="education-heading">
      <div class="cv-section-heading">
        <span>06</span>
        <h2 id="education-heading">education & credentials</h2>
      </div>

      <div class="grid gap-8 sm:grid-cols-[1.4fr_0.6fr]">
        <div class="space-y-6">
          <div class="space-y-1">
            <h3 class="text-sm leading-6 text-[var(--pink-bright)]">
              Wyższa Szkoła Informatyki i Zarządzania w Bielsku-Białej
            </h3>
            <p class="text-xs leading-6">Bachelor (Lic.) · Computer Programming</p>
            <p class="cv-date">2020—2021</p>
          </div>
          <div class="space-y-1">
            <h3 class="text-sm leading-6 text-[var(--pink-bright)]">
              Zespół Szkół Elektronicznych, Elektrycznych i Mechanicznych im. Jędrzeja Śniadeckiego
            </h3>
            <p class="text-xs leading-6">Technician · Information Technology</p>
            <p class="cv-date">2016—2020</p>
          </div>
        </div>

        <div class="cv-panel space-y-6">
          <div class="space-y-2">
            <p class="cv-kicker">languagecert lte</p>
            <p class="text-xs leading-6">Listening & Reading · C2<br />Writing · C1</p>
          </div>
          <div class="space-y-2">
            <p class="cv-kicker">languages</p>
            <p class="text-xs leading-6">Polish · Native<br />English · Full professional</p>
          </div>
        </div>
      </div>
    </section>

    <div class="cv-end flex items-center gap-4" aria-hidden="true">
      <span class="h-px flex-1 bg-[var(--pink-soft)]"></span>
      <span class="text-[0.65rem] uppercase tracking-[0.35em] text-[var(--pink-dim)]">end of record</span>
      <span class="h-px flex-1 bg-[var(--pink-soft)]"></span>
    </div>
  </article>
</PageShell>

<style>
  .cv-kicker,
  .cv-date {
    font-size: 0.65rem;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--pink-dim);
  }

  .cv-section {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .cv-section-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--pink-soft);
    font-family: "Chakra Petch", sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.22em;
  }

  .cv-section-heading span {
    font-size: 0.65rem;
    color: var(--pink-dim);
  }

  .cv-section-heading h2 {
    font-size: 0.8rem;
    color: var(--pink-bright);
  }

  .cv-panel {
    border: 1px solid var(--pink-soft);
    padding: 1rem;
    background: linear-gradient(135deg, rgba(0, 245, 255, 0.045), rgba(0, 245, 255, 0.01));
    box-shadow: inset 0 0 24px rgba(0, 245, 255, 0.015);
  }

  .cv-chip {
    border: 1px solid var(--pink-soft);
    padding: 0.45rem 0.7rem;
    font-size: 0.7rem;
    color: var(--pink-dim);
  }

  .cv-chip-strong {
    border-color: rgba(0, 245, 255, 0.45);
    color: var(--pink-bright);
    box-shadow: 0 0 12px rgba(0, 245, 255, 0.06);
  }

  .cv-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cv-list li {
    position: relative;
    padding-left: 1rem;
  }

  .cv-list li::before {
    content: ">";
    position: absolute;
    left: 0;
    color: var(--pink-dim);
  }

  .cv-timeline {
    border-left: 1px solid var(--pink-soft);
    margin-left: 0.25rem;
    padding-left: 1.5rem;
  }

  .cv-timeline-item {
    position: relative;
  }

  .cv-timeline-item::before {
    content: "";
    position: absolute;
    top: 0.4rem;
    left: -1.78rem;
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--pink);
    background: var(--bg);
    box-shadow: 0 0 10px rgba(0, 245, 255, 0.55);
  }

  .cv-quote {
    border-left: 1px solid var(--pink);
    padding: 0.2rem 0 0.2rem 1rem;
    font-size: 0.75rem;
    line-height: 1.75;
  }

  .cv-quote footer {
    margin-top: 0.75rem;
    font-size: 0.62rem;
    line-height: 1.6;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--pink-dim);
  }

  .cv-button {
    border: 1px solid rgba(0, 245, 255, 0.45);
    padding: 0.55rem 0.8rem;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--pink-bright);
    cursor: pointer;
    transition: background-color 150ms ease, box-shadow 150ms ease;
  }

  .cv-button:hover {
    background: rgba(0, 245, 255, 0.08);
    box-shadow: 0 0 16px rgba(0, 245, 255, 0.16);
  }

  @media print {
    :global(body) {
      background: #fff !important;
      color: #10252a !important;
      font-size: 10pt;
    }

    :global(.site-nav),
    :global(.site-footer),
    .print-control,
    .cv-end,
    .cv-header img,
    .cv-header div[aria-hidden="true"] {
      display: none !important;
    }

    :global(main) {
      max-width: none !important;
      min-height: 0 !important;
      padding: 0 !important;
    }

    .cv-page {
      gap: 2rem !important;
      color: #17343a !important;
    }

    .cv-header {
      padding: 0 0 1rem !important;
      border-color: #a7c7cc !important;
    }

    .cv-section {
      gap: 1rem;
      break-inside: auto;
    }

    .cv-panel,
    .cv-quote,
    .cv-timeline-item {
      break-inside: avoid;
    }

    .cv-panel {
      background: transparent !important;
      border-color: #b8d2d6 !important;
      box-shadow: none !important;
    }

    .cv-section-heading,
    .cv-timeline,
    .cv-chip,
    .cv-quote {
      border-color: #b8d2d6 !important;
    }

    .cv-section-heading h2,
    .cv-chip-strong,
    .cv-page :global(.text-\[var\(--pink-bright\)\]),
    .cv-page :global(.neon-link) {
      color: #075b66 !important;
      text-shadow: none !important;
    }

    .cv-kicker,
    .cv-date,
    .cv-page :global(.text-\[var\(--pink-dim\)\]) {
      color: #40747b !important;
    }

    .cv-timeline-item::before {
      border-color: #075b66;
      background: #fff;
      box-shadow: none;
    }

    a {
      color: inherit;
      text-decoration: none;
    }
  }
</style>
