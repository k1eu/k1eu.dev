---
import PageShell from "../../layouts/PageShell.astro";

const coreStack = ["TypeScript", "React", "React Native", "Node.js", "Bun"];
const additionalStack = ["Python", "Next.js", "Expo", "Tailwind", "PostgreSQL", "Docker", "CI/CD", "Tests"];

const earlierExperience = [
  { role: "Web Developer", company: "Re Bena Gesta", detail: "Next.js, headless WordPress, SEO", date: "Mar—May 2021" },
  { role: "Webmaster", company: "Setia.pl", detail: "Linux hosting, WordPress, SEO", date: "Jan—Mar 2021" },
  { role: "Quality Assurance", company: "RES Global Group", date: "Aug—Sep 2020" },
  { role: "Web Dev Intern", company: "Da Vinci Studio", date: "Sep—Dec 2019" },
  { role: "Sales & Customer Service", company: "Big Star Limited", date: "Jun 2018—Jan 2019" },
];

const projects = [
  {
    name: "OPTI-ENER",
    label: "mobile app",
    href: "https://apps.apple.com/pl/app/opti-ener/id6473692228",
    linkLabel: "app store ↗",
    description: "Remote access to the OPTI-ENER electricity management system for heat pumps.",
    stack: "React Native · Expo · TypeScript",
  },
  {
    name: "TypedFormData",
    label: "open source",
    href: "https://github.com/k1eu/typed-formdata",
    linkLabel: "github ↗",
    description: "A small utility library for working with FormData in TypeScript.",
    stack: "TypeScript",
  },
  {
    name: "Just TypeScript Snippets",
    label: "developer tool",
    href: "https://marketplace.visualstudio.com/items?itemName=k1eu.just-ts-snippets",
    linkLabel: "marketplace ↗",
    description: "Bare-necessities JavaScript and TypeScript snippets for VS Code.",
    stack: "VS Code · JavaScript · TypeScript",
  },
];
---

<PageShell
  title="Tomasz Kielar / CV"
  description="Tomasz Kielar — Tech Lead, full-stack engineer, and consultant."
  ogUrl="https://k1eu.dev/cv/"
  mainClass="gap-10"
>
  <article class="cv-page flex w-full flex-col gap-14 text-left">
    <header class="cv-header relative overflow-hidden border-y border-[var(--pink-soft)] py-8 sm:py-10">
      <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-40 sm:block" aria-hidden="true">
        <img
          src="/avatar.png"
          alt=""
          class="h-full w-full object-contain object-right opacity-20 drop-shadow-[0_0_24px_rgba(0,245,255,0.55)]"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black via-black/40 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-xl space-y-5">
        <div class="space-y-2">
          <p class="cv-kicker">personnel record // 001</p>
          <h1 class="glitch text-4xl font-semibold sm:text-5xl" data-text="tomasz kielar">tomasz kielar</h1>
          <p class="text-sm text-[var(--pink-bright)] sm:text-base">tech lead · full-stack engineer · consultant · cursor ambassador</p>
          <p class="text-xs uppercase tracking-[0.25em] text-[var(--pink-dim)]">bielsko-biała, poland</p>
        </div>

        <div class="flex flex-wrap gap-x-5 gap-y-2 text-xs">
          <a class="neon-link underline underline-offset-4" href="mailto:me@k1eu.dev">me@k1eu.dev</a>
          <a class="neon-link underline underline-offset-4" href="tel:+48792200218">+48 792 200 218</a>
          <a class="neon-link underline underline-offset-4" href="https://www.linkedin.com/in/k1eu/">linkedin ↗</a>
          <a class="neon-link underline underline-offset-4" href="https://github.com/k1eu">github ↗</a>
        </div>

        <button class="print-control cv-button" type="button" onclick="window.print()">print / save pdf</button>
      </div>
    </header>
