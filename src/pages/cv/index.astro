---
import PageShell from "../../layouts/PageShell.astro";

const stackGroups = [
  { label: "core", items: ["TypeScript", "React", "React Native", "Node.js", "Bun"], strong: true },
  { label: "web", items: ["Next.js", "TanStack Start", "React Router", "Vite"] },
  { label: "backend", items: ["Elysia", "Hono", "Express", "Python (FastAPI)"] },
  { label: "databases", items: ["PostgreSQL", "Redis", "SQLite"] },
  { label: "mobile", items: ["Expo", "EAS"] },
  { label: "ai implementation", items: ["AI SDK", "LangGraph", "RAG (pgvector)", "embedding pipelines"] },
  { label: "ai tools", items: ["Cursor", "Claude Code", "Grok Bot"] },
  {
    label: "infra & quality",
    items: ["Docker", "GitHub Actions", "Cloudflare", "Hetzner", "AWS", "Vercel", "Vitest", "Playwright"],
  },
];

const earlierExperience = [
  { role: "Web Developer", company: "Re Bena Gesta", detail: "Next.js, headless WordPress, SEO", date: "Mar—May 2021" },
  { role: "Webmaster", company: "Setia.pl", detail: "Linux hosting, WordPress, SEO", date: "Jan—Mar 2021" },
  { role: "Web Dev Intern", company: "Da Vinci Studio", date: "Sep—Dec 2019" },
];

const projects = [
  {
    name: "OPTI-ENER",
    label: "mobile app",
    href: "https://apps.apple.com/pl/app/opti-ener/id6473692228",
    linkLabel: "app store",
    ariaLabel: "OPTI-ENER on the App Store",
    printUrl: "apps.apple.com/app/opti-ener",
    description: "Remote access to the OPTI-ENER electricity management system for heat pumps.",
    stack: "React Native · Expo · TypeScript",
  },
  {
    name: "TypedFormData",
    label: "open source",
    href: "https://github.com/k1eu/typed-formdata",
    linkLabel: "github",
    ariaLabel: "TypedFormData on GitHub",
    printUrl: "github.com/k1eu/typed-formdata",
    description: "A small utility library for working with FormData in TypeScript.",
    stack: "TypeScript",
  },
  {
    name: "Just TypeScript Snippets",
    label: "developer tool",
    href: "https://marketplace.visualstudio.com/items?itemName=k1eu.just-ts-snippets",
    linkLabel: "marketplace",
    ariaLabel: "Just TypeScript Snippets on the VS Code Marketplace",
    printUrl: "marketplace.visualstudio.com",
    description: "Bare-necessities JavaScript and TypeScript snippets for VS Code.",
    stack: "VS Code · JavaScript · TypeScript",
  },
];
---

<PageShell
  title="Tomasz Kielar / CV"
  description="Tomasz Kielar — Tech Lead, full-stack engineer (web & mobile), SpaceXSI Ambassador. AI-native development and co-owner of bielsko.ai."
  ogUrl="https://k1eu.dev/cv/"
  mainClass="gap-10"
>
  <article class="cv-page flex w-full flex-col gap-14 text-left">
    <header class="cv-header relative overflow-hidden border-y border-[var(--pink-soft)] py-8 sm:py-10">
      <div class="cv-header-main">
        <div class="cv-header-copy space-y-5">
          <div class="space-y-2">
            <p class="cv-kicker">personnel record // 001</p>
            <h1 class="glitch text-4xl font-semibold sm:text-5xl" data-text="tomasz kielar">tomasz kielar</h1>
            <div class="space-y-1">
              <p class="text-sm text-[var(--pink-bright)] sm:text-base">tech lead · full-stack engineer · consultant</p>
              <p class="text-sm text-[var(--pink-bright)] sm:text-base">SpaceXSI Ambassador</p>
            </div>
            <p class="text-xs uppercase tracking-[0.25em] text-[var(--pink-dim)]">bielsko-biała, poland</p>
          </div>

          <div class="flex flex-wrap gap-x-5 gap-y-2 text-xs">
            <a class="neon-link underline underline-offset-4" href="mailto:me@k1eu.dev">me@k1eu.dev</a>
            <a
              class="neon-link cv-contact-link underline underline-offset-4"
              href="https://www.linkedin.com/in/k1eu/"
              aria-label="Tomasz Kielar on LinkedIn"
              data-print-label="linkedin.com/in/k1eu"
            >
              <span class="cv-link-label">linkedin <span aria-hidden="true">↗</span></span>
            </a>
            <a
              class="neon-link cv-contact-link underline underline-offset-4"
              href="https://github.com/k1eu"
              aria-label="Tomasz Kielar on GitHub"
              data-print-label="github.com/k1eu"
            >
              <span class="cv-link-label">github <span aria-hidden="true">↗</span></span>
            </a>
          </div>

          <button class="print-control cv-button" type="button" onclick="window.print()">print / save pdf</button>
        </div>

        <div class="cv-header-photo">
          <img
            src="/tomasz-kielar.jpg"
            alt="Tomasz Kielar"
            width="560"
            height="700"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </header>

    <section class="cv-section" aria-labelledby="profile-heading">
      <div class="cv-section-heading">
        <span>01</span>
        <h2 id="profile-heading">profile</h2>
      </div>

      <div class="grid gap-8 sm:grid-cols-[1.25fr_0.75fr]">
        <div class="space-y-4">
          <p class="text-sm leading-7 text-[var(--pink-bright)]">
            Tech Lead and full-stack engineer with 5+ years of experience delivering web and mobile products using
            TypeScript, React, React Native, Node.js, and Bun.
          </p>
          <p class="text-sm leading-7">
            SpaceXSI Ambassador and co-owner / lead of bielsko.ai, a local AI community for meetups and workshops.
            I teach teams AI-native development.
          </p>
        </div>

        <div class="cv-panel space-y-4">
          <p class="cv-kicker">operating strengths</p>
          <ul class="cv-list text-xs leading-6">
            <li>architecture to release</li>
            <li>technical leadership & mentoring</li>
            <li>client & stakeholder alignment</li>
            <li>ai-native development & enablement</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="cv-section" aria-labelledby="stack-heading">
      <div class="cv-section-heading">
        <span>02</span>
        <h2 id="stack-heading">stack</h2>
      </div>

      <div class="cv-stack">
        {
          stackGroups.map(({ label, items, strong }) => (
            <div class:list={["cv-stack-group", { "cv-stack-core": strong }]}>
              <p class="cv-kicker">{label}</p>
              <ul class="flex flex-wrap gap-2" aria-label={label}>
                {items.map((technology) => (
                  <li class:list={["cv-chip", { "cv-chip-strong": strong }]}>{technology}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="cv-section" aria-labelledby="experience-heading">
      <div class="cv-section-heading">
        <span>03</span>
        <h2 id="experience-heading">experience</h2>
      </div>

      <div class="cv-timeline space-y-10">
        <article class="cv-timeline-item space-y-5">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="display text-xl font-semibold text-[var(--pink-bright)]">Selleo</h3>
              <p class="mt-1 text-sm">full-stack engineer / tech lead</p>
            </div>
            <p class="cv-date">may 2021—present · hybrid</p>
          </div>

          <div class="cv-role-grid grid gap-5 sm:grid-cols-2">
            <div class="cv-panel space-y-2">
              <h4 class="text-sm text-[var(--pink-bright)]">Full-stack engineer / Tech lead</h4>
              <p class="cv-date">may 2023—present</p>
              <ul class="cv-list text-xs leading-6">
                <li>Drove reskilling of engineers into full-stack developers across a ~100-person company.</li>
                <li>Built and ran the process of teaching engineers AI-native development from the ground up.</li>
                <li>Lead web and mobile projects in 2–5 person teams for EdTech and music-industry clients.</li>
                <li>Own architecture of web and mobile projects, from implementation through client communication.</li>
                <li>Integrate AI into user-facing applications: chatbots and agents that take actions inside the system.</li>
                <li>Build full-stack Node.js and Bun applications.</li>
              </ul>
            </div>
            <div class="cv-panel space-y-2">
              <h4 class="text-sm text-[var(--pink-bright)]">Frontend developer</h4>
              <p class="cv-date">may 2021—may 2023</p>
              <ul class="cv-list text-xs leading-6">
                <li>Built React and React Native applications for EdTech and PropTech clients.</li>
                <li>Led frontend delivery and contributed across the product lifecycle.</li>
              </ul>
            </div>
          </div>
        </article>

        <article class="cv-timeline-item space-y-3">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="display text-xl font-semibold text-[var(--pink-bright)]">SpaceXSI Ambassador</h3>
            </div>
            <p class="cv-date">2026—present</p>
          </div>
          <ul class="cv-list text-sm leading-7">
            <li>Organize events for SpaceXSI and train people to work effectively with AI.</li>
            <li>
              Cafe Cursor Bielsko-Biała #001 — 29 Aug 2026, NovaPatria.{" "}
              <a
                class="neon-link cv-text-link"
                href="https://luma.com/vz2m9zkf"
                aria-label="Cafe Cursor Bielsko-Biała #001 on Luma"
                data-print-url="luma.com/vz2m9zkf"
              >
                luma <span aria-hidden="true">↗</span>
              </a>
            </li>
          </ul>
        </article>

        <article class="cv-timeline-item space-y-3">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="display text-xl font-semibold text-[var(--pink-bright)]">bielsko.ai</h3>
              <p class="mt-1 text-sm">co-owner</p>
            </div>
            <p class="cv-date">apr 2026—present</p>
          </div>
          <ul class="cv-list text-sm leading-7">
            <li>Build a local community around practical AI adoption.</li>
            <li>Develop the brand, secure financing and partnerships, and organize events.</li>
            <li>Present practical AI workflows to the local community.</li>
            <li>
              bielsko.ai #001 — 26 Jun 2026.{" "}
              <a
                class="neon-link cv-text-link"
                href="https://luma.com/r3dmef6s"
                aria-label="bielsko.ai #001 on Luma"
                data-print-url="luma.com/r3dmef6s"
              >
                luma <span aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              bielsko.ai #002 — 18 Sep 2026, REKORD SI.{" "}
              <a
                class="neon-link cv-text-link"
                href="https://luma.com/6qzbenue"
                aria-label="bielsko.ai #002 on Luma"
                data-print-url="luma.com/6qzbenue"
              >
                luma <span aria-hidden="true">↗</span>
              </a>
            </li>
          </ul>
        </article>

        <article class="cv-timeline-item space-y-3">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="display text-xl font-semibold text-[var(--pink-bright)]">recave</h3>
              <p class="mt-1 text-sm">co-founder & developer</p>
            </div>
            <p class="cv-date">client projects</p>
          </div>
          <p class="text-sm leading-7">
            Co-founded a product and consultancy initiative delivering business applications for external clients,
            alongside technical media and podcasts.
          </p>
          <ul class="cv-list text-sm leading-7">
            <li>
              OPTI-ENER — mobile app for remote access to the OPTI-ENER electricity management system for heat pumps.
              React Native, Expo, TypeScript.{" "}
              <a
                class="neon-link cv-text-link"
                href="https://apps.apple.com/pl/app/opti-ener/id6473692228"
                aria-label="OPTI-ENER on the App Store"
                data-print-url="apps.apple.com/app/opti-ener"
              >
                app store <span aria-hidden="true">↗</span>
              </a>
            </li>
          </ul>
        </article>

        <article class="cv-timeline-item space-y-4">
          <p class="cv-kicker">earlier assignments</p>
          <div class="divide-y divide-[var(--pink-soft)] border-y border-[var(--pink-soft)]">
            {
              earlierExperience.map(({ role, company, detail, date }) => (
                <div class="grid gap-1 py-3 text-xs sm:grid-cols-[1fr_auto] sm:gap-6">
                  <p>
                    <span class="text-[var(--pink-bright)]">{company} / {role}</span>
                    {detail && <span class="text-[var(--pink-dim)]"> · {detail}</span>}
                  </p>
                  <p class="cv-date">{date}</p>
                </div>
              ))
            }
          </div>
        </article>
      </div>
    </section>

    <section class="cv-section" aria-labelledby="projects-heading">
      <div class="cv-section-heading">
        <span>04</span>
        <h2 id="projects-heading">selected projects</h2>
      </div>

      <div class="cv-projects grid gap-4 sm:grid-cols-3">
        {
          projects.map(({ name, label, href, linkLabel, ariaLabel, printUrl, description, stack }) => (
            <article class="cv-panel flex min-h-56 flex-col gap-4">
              <div class="space-y-1">
                <p class="cv-kicker">{label}</p>
                <h3 class="display text-lg font-semibold text-[var(--pink-bright)]">{name}</h3>
              </div>
              <p class="text-xs leading-6">{description}</p>
              <div class="mt-auto space-y-3">
                <p class="text-[0.65rem] uppercase tracking-[0.18em] text-[var(--pink-dim)]">{stack}</p>
                <a
                  class="neon-link text-xs underline underline-offset-4"
                  href={href}
                  aria-label={ariaLabel}
                  data-print-url={printUrl}
                >
                  {linkLabel} <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="cv-section" aria-labelledby="recommendations-heading">
      <div class="cv-section-heading">
        <span>05</span>
        <h2 id="recommendations-heading">field reports</h2>
      </div>

      <div class="cv-quotes grid gap-5 sm:grid-cols-2">
        <blockquote class="cv-quote">
          <p>
            “He assisted in both AI development and research, helping build smart features across multi-verticals
            that required switch in thinking at all times. He stayed well-informed on fast moving AI trends, which
            kept our goals moving forward.”
          </p>
          <footer>Mohamad Kinawi · Founder &amp; CEO (client) · 2026</footer>
        </blockquote>
        <blockquote class="cv-quote">
          <p>
            “…I can honestly say that he is one of the most talented Front-end ReactJS developers I have ever
            worked with. Tomasz has a deep understanding of ReactJS and other front-end technologies, and he has
            an amazing ability to take on complex interfaces and turn them into highly functional and intuitive
            user experiences.”
          </p>
          <footer>Rob Eifler · CTO &amp; Co-Founder at Defined (client) · 2023</footer>
        </blockquote>
      </div>
      <p class="mt-5 text-xs text-[var(--pink-dim)]">
        complete reports available on
        <a
          class="neon-link cv-text-link"
          href="https://www.linkedin.com/in/k1eu/"
          aria-label="Tomasz Kielar recommendations on LinkedIn"
        >
          linkedin <span aria-hidden="true">↗</span>
        </a>
      </p>
    </section>

    <section class="cv-section" aria-labelledby="education-heading">
      <div class="cv-section-heading">
        <span>06</span>
        <h2 id="education-heading">education & credentials</h2>
      </div>

      <div class="grid gap-8 sm:grid-cols-[1.4fr_0.6fr]">
        <div class="space-y-6">
          <div class="space-y-1">
            <h3 class="text-sm leading-6 text-[var(--pink-bright)]">
              Wyższa Szkoła Informatyki i Zarządzania w Bielsku-Białej
            </h3>
            <p class="text-xs leading-6">Bachelor (Lic.) · Computer Programming</p>
            <p class="cv-date">2020—2021</p>
          </div>
          <div class="space-y-1">
            <h3 class="text-sm leading-6 text-[var(--pink-bright)]">
              Zespół Szkół Elektronicznych, Elektrycznych i Mechanicznych im. Jędrzeja Śniadeckiego
            </h3>
            <p class="text-xs leading-6">Technician · Information Technology</p>
            <p class="cv-date">2016—2020</p>
          </div>
        </div>

        <div class="cv-panel space-y-6">
          <div class="space-y-2">
            <p class="cv-kicker">languagecert lte</p>
            <p class="text-xs leading-6">Listening & Reading · C2<br />Writing · C1</p>
          </div>
          <div class="space-y-2">
            <p class="cv-kicker">languages</p>
            <p class="text-xs leading-6">Polish · Native<br />English · Full professional</p>
          </div>
        </div>
      </div>
    </section>

    <div class="cv-end flex items-center gap-4" aria-hidden="true">
      <span class="h-px flex-1 bg-[var(--pink-soft)]"></span>
      <span class="text-[0.65rem] uppercase tracking-[0.35em] text-[var(--pink-dim)]">end of record</span>
      <span class="h-px flex-1 bg-[var(--pink-soft)]"></span>
    </div>
  </article>
</PageShell>

<style>
  .cv-kicker,
  .cv-date {
    font-size: 0.65rem;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--pink-dim);
  }

  .cv-section {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .cv-section-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--pink-soft);
    font-family: "Chakra Petch", sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.22em;
  }

  .cv-section-heading span {
    font-size: 0.65rem;
    color: var(--pink-dim);
  }

  .cv-section-heading h2 {
    font-size: 0.8rem;
    color: var(--pink-bright);
  }

  .cv-panel {
    border: 1px solid var(--pink-soft);
    padding: 1rem;
    background: linear-gradient(135deg, rgba(0, 245, 255, 0.045), rgba(0, 245, 255, 0.01));
    box-shadow: inset 0 0 24px rgba(0, 245, 255, 0.015);
  }

  .cv-chip {
    border: 1px solid var(--pink-soft);
    padding: 0.45rem 0.7rem;
    font-size: 0.7rem;
    color: var(--pink-dim);
  }

  .cv-chip-strong {
    border-color: rgba(0, 245, 255, 0.45);
    color: var(--pink-bright);
    box-shadow: 0 0 12px rgba(0, 245, 255, 0.06);
  }

  .cv-stack {
    display: grid;
    gap: 1.15rem 1.5rem;
  }

  .cv-stack-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .cv-stack {
      grid-template-columns: 1fr 1fr;
    }

    .cv-stack-core {
      grid-column: 1 / -1;
    }
  }

  .cv-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cv-list li {
    position: relative;
    padding-left: 1rem;
  }

  .cv-list li::before {
    content: ">";
    position: absolute;
    left: 0;
    color: var(--pink-dim);
  }

  .cv-timeline {
    border-left: 1px solid var(--pink-soft);
    margin-left: 0.25rem;
    padding-left: 1.5rem;
  }

  .cv-timeline-item {
    position: relative;
  }

  .cv-timeline-item::before {
    content: "";
    position: absolute;
    top: 0.4rem;
    left: -1.78rem;
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--pink);
    background: var(--bg);
    box-shadow: 0 0 10px rgba(0, 245, 255, 0.55);
  }

  .cv-quote {
    border-left: 1px solid var(--pink);
    padding: 0.2rem 0 0.2rem 1rem;
    font-size: 0.75rem;
    line-height: 1.75;
  }

  .cv-quote footer {
    margin-top: 0.75rem;
    font-size: 0.62rem;
    line-height: 1.6;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--pink-dim);
  }

  .cv-button {
    border: 1px solid rgba(0, 245, 255, 0.45);
    padding: 0.55rem 0.8rem;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--pink-bright);
    cursor: pointer;
    transition: background-color 150ms ease, box-shadow 150ms ease;
  }

  .cv-button:hover {
    background: rgba(0, 245, 255, 0.08);
    box-shadow: 0 0 16px rgba(0, 245, 255, 0.16);
  }

  .cv-text-link {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--pink) 55%, transparent);
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
  }

  .cv-header-main {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.1rem;
  }

  .cv-header-copy {
    position: relative;
    z-index: 10;
    min-width: 0;
    flex: 1 1 auto;
  }

  .cv-header-photo {
    flex: 0 0 7.25rem;
    width: 7.25rem;
  }

  @media (min-width: 640px) {
    .cv-header-main {
      gap: 1.75rem;
    }

    .cv-header-photo {
      flex-basis: 9.5rem;
      width: 9.5rem;
    }
  }

  .cv-header-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 18%;
    border-radius: 0.35rem;
    border: 1px solid var(--pink-soft);
    box-shadow: 0 0 20px rgba(0, 245, 255, 0.32);
  }

  @page {
    size: A4;
    margin: 14mm;
  }

  @media print {
    :global(body) {
      background: #fff !important;
      color: #10252a !important;
      font-size: 9.4pt;
    }

    :global(.site-nav),
    :global(.site-footer),
    .print-control,
    .cv-end {
      display: none !important;
    }

    :global(main) {
      max-width: none !important;
      min-height: 0 !important;
      padding: 0 !important;
    }

    .cv-page {
      gap: 1.15rem !important;
      color: #17343a !important;
    }

    .cv-header {
      padding: 0 0 0.55rem !important;
      border-color: #a7c7cc !important;
    }

    .cv-header-main {
      align-items: flex-start;
      gap: 0.85rem;
    }

    .cv-header-photo {
      flex-basis: 30mm;
      width: 30mm;
    }

    .cv-header-photo img {
      display: block !important;
      border-radius: 2px;
      border-color: #b8d2d6;
      box-shadow: none !important;
      filter: none;
    }

    .cv-header h1,
    .cv-page :global(.glitch) {
      color: #10252a !important;
      text-shadow: none !important;
    }

    .cv-page :global(.glitch)::before,
    .cv-page :global(.glitch)::after {
      content: none !important;
      display: none !important;
    }

